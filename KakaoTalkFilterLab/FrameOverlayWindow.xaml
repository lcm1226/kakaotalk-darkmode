<Window x:Class="KakaoTalkFilterLab.FrameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="False"
        Background="#FF000000"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid IsHitTestVisible="False" Background="#FF000000">
        <Image x:Name="CaptureImage"
               Stretch="Fill"
               Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="LowQuality"
               SnapsToDevicePixels="True" />
        <Canvas x:Name="PrivacyMaskLayer"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border x:Name="PrivacyTopCover"
                    Background="#FF050505" />
            <Border x:Name="PrivacyBodyCover"
                    Background="#FF050505" />
        </Canvas>
    </Grid>
</Window>