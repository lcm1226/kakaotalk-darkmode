<Window x:Class="KakaoTalkFilterLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KakaoTalk Filter Lab"
        Icon="Assets/AppIcon.ico"
        Width="760"
        Height="520"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        FontFamily="Pretendard Variable, Pretendard, Segoe UI"
        FontWeight="SemiBold"
        TextElement.Foreground="{DynamicResource AppTextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="AppWindowBrush" Color="#EEF1F4" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="AppGridBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="AppGridBorderBrush" Color="#D4D9E1" />
        <SolidColorBrush x:Key="AppGridRowBrush" Color="#F6F8FA" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="KakaoTalk Filter Lab" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Phase 2 for the native prototype: track the KakaoTalk main window and attach a click-through dim overlay before attempting color processing." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="#111"
                BorderBrush="#222"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="#AAA" Text="Overlay" />
                <StackPanel Grid.Column="1">
                    <WrapPanel VerticalAlignment="Center">
                        <CheckBox x:Name="OverlayEnabledCheckBox"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="#F5F7FA"
                                  Content="Enabled"
                                  IsChecked="True" />
                        <CheckBox x:Name="PrivacyModeCheckBox"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="#F5F7FA"
                                  Content="Privacy mode" />
                        <TextBlock VerticalAlignment="Center" Foreground="#AAA" Text="Mode" />
                        <ComboBox x:Name="ModeComboBox"
                                  Width="90"
                                  Margin="8,0,12,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Dim" />
                            <ComboBoxItem Content="Invert" />
                            <ComboBoxItem Content="Smart" />
                        </ComboBox>
                        <TextBlock x:Name="ParameterLabel"
                                   VerticalAlignment="Center"
                                   Foreground="#AAA"
                                   Text="Opacity" />
                        <Slider x:Name="OpacitySlider"
                                Width="110"
                                Margin="8,0,8,0"
                                Minimum="0"
                                Maximum="200"
                                Value="115" />
                        <TextBlock x:Name="ParameterValue"
                                   Width="42"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   TextAlignment="Right"
                                   Text="45%" />
                        <Button x:Name="ExportFramesButton"
                                Padding="10,2"
                                Content="Export Frames" />
                    </WrapPanel>

                    <Grid x:Name="FilterSettingsPanel"
                          Margin="0,10,0,0"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#AAA" VerticalAlignment="Center" Text="Strength" />
                        <Slider x:Name="StrengthSlider"
                                Grid.Row="0"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="100" />
                        <TextBlock x:Name="StrengthValue"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   Text="100%" />

                        <TextBlock Grid.Row="2" Foreground="#AAA" VerticalAlignment="Center" Text="Brightness" />
                        <Slider x:Name="BrightnessSlider"
                                Grid.Row="2"
                                Grid.Column="1"
                                Minimum="-100"
                                Maximum="100"
                                Value="0" />
                        <TextBlock x:Name="BrightnessValue"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   Text="0" />

                        <TextBlock Grid.Row="4" Foreground="#AAA" VerticalAlignment="Center" Text="Contrast" />
                        <Slider x:Name="ContrastSlider"
                                Grid.Row="4"
                                Grid.Column="1"
                                Minimum="50"
                                Maximum="170"
                                Value="100" />
                        <TextBlock x:Name="ContrastValue"
                                   Grid.Row="4"
                                   Grid.Column="2"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   Text="100%" />

                        <TextBlock Grid.Row="6" Foreground="#AAA" VerticalAlignment="Center" Text="Gamma" />
                        <Slider x:Name="GammaSlider"
                                Grid.Row="6"
                                Grid.Column="1"
                                Minimum="60"
                                Maximum="180"
                                Value="100" />
                        <TextBlock x:Name="GammaValue"
                                   Grid.Row="6"
                                   Grid.Column="2"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   Text="100%" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="2" Foreground="#AAA" Text="Status" />
                <TextBlock x:Name="StatusValue" Grid.Row="2" Grid.Column="1" Foreground="White" Text="Scanning..." />

                <TextBlock Grid.Row="4" Foreground="#AAA" Text="Capture" />
                <TextBlock x:Name="CaptureValue" Grid.Row="4" Grid.Column="1" Foreground="White" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="6" Foreground="#AAA" Text="Handle" />
                <TextBlock x:Name="HandleValue" Grid.Row="6" Grid.Column="1" Foreground="White" Text="-" />

                <TextBlock Grid.Row="8" Foreground="#AAA" Text="Title" />
                <TextBlock x:Name="TitleValue" Grid.Row="8" Grid.Column="1" Foreground="White" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="10" Foreground="#AAA" Text="Class" />
                <TextBlock x:Name="ClassValue" Grid.Row="10" Grid.Column="1" Foreground="White" Text="-" />

                <TextBlock Grid.Row="12" Foreground="#AAA" Text="Bounds" />
                <TextBlock x:Name="BoundsValue" Grid.Row="12" Grid.Column="1" Foreground="White" Text="-" />

                <TextBlock Grid.Row="14" Foreground="#AAA" Text="Export" />
                <TextBlock x:Name="ExportValue" Grid.Row="14" Grid.Column="1" Foreground="White" Text="-" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Candidate windows" />

            <DataGrid x:Name="CandidatesGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      Background="{DynamicResource AppGridBackgroundBrush}"
                      BorderBrush="{DynamicResource AppGridBorderBrush}"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      RowBackground="{DynamicResource AppGridBackgroundBrush}"
                      RowHeaderWidth="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="100" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="180" />
                    <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="70" />
                    <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
