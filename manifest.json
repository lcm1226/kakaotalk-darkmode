{
  "manifest_version": 3,
  "name": "Remap Key",
  "version": "0.1.0",
  "description": "Apply URL-specific keyboard remapping rules with a simple popup and options page.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Remap Key",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
